# Supabase Configuration
# The base URL of your Supabase project (from the Supabase Dashboard API Settings)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL

# The publishable/anonymous API key for your Supabase project
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# The Google OAuth redirect URL
# In local development: use http://localhost:5173
# In production: use your deployed Render frontend domain (e.g. https://your-production-app.onrender.com)
VITE_SUPABASE_REDIRECT_URL=YOUR_RENDER_APP_URL
